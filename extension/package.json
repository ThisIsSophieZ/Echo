{
  "name": "echo-sidebar",
  "displayName": "Echo Sidebar",
  "version": "0.1.0",
  "description": "A lightweight Chrome side panel for capturing and recalling useful thought fragments.",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@plasmohq/messaging": "^0.7.2",
    "dexie": "^4.0.11",
    "lucide-react": "^1.21.0",
    "plasmo": "^0.90.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^20.10.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "manifest": {
    "manifest_version": 3,
    "name": "Echo Sidebar",
    "short_name": "Echo",
    "version": "0.1.0",
    "description": "Capture the thought that lit up, then let it echo beside your next LLM session.",
    "permissions": [
      "activeTab",
      "contextMenus",
      "sidePanel",
      "storage",
      "tabs"
    ],
    "host_permissions": [
      "https://chatgpt.com/*",
      "https://chat.openai.com/*",
      "https://claude.ai/*",
      "https://gemini.google.com/*",
      "https://grok.com/*",
      "https://x.com/*"
    ],
    "action": {
      "default_title": "Open Echo"
    }
  }
}
