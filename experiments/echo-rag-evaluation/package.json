{
  "name": "echo-rag-evaluation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Retrieval and grounded-generation evaluation lab for Echo public fixtures. Not product code.",
  "scripts": {
    "retrieval:dev": "tsx src/run-retrieval.ts --dataset=dev --strategy=product-gate",
    "retrieval:candidate:dev": "tsx src/run-retrieval.ts --dataset=dev --strategy=candidate-bm25",
    "generation:dev": "tsx src/run-generation.ts --dataset=dev",
    "generation:holdout": "tsx src/run-generation.ts --dataset=holdout",
    "retrieval:holdout": "tsx src/run-retrieval.ts --dataset=holdout",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
