{
  "name": "echo-recall-benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline recall benchmark for Echo: BM25 (product) vs local embeddings vs hybrid. Not product code.",
  "scripts": {
    "seed": "tsx src/seed-fixture.ts",
    "bench": "tsx src/run-benchmark.ts",
    "bench:lexical": "tsx src/run-benchmark.ts --strategies=bm25",
    "all": "tsx src/seed-fixture.ts && tsx src/run-benchmark.ts"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
